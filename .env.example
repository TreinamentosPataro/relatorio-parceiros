# Copie para .env apenas no ambiente local e substitua os valores de exemplo.
# Nunca versione o arquivo .env.
APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_DB=partner_reports
POSTGRES_USER=partner_reports
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+psycopg://partner_reports:replace-with-a-local-password@localhost:5432/partner_reports
PDF_STORAGE_ROOT=storage/pdf-imports

# Auditoria Advbox (somente leitura). Preencha o token apenas no .env local.
ADVBOX_API_BASE_URL=https://app.advbox.com.br/api/v1
ADVBOX_API_TOKEN=
