# Copie para deploy/production.env no host e proteja com chmod 600.
# Não reutilize estes placeholders.
APP_ENV=staging
DATABASE_URL=postgresql+psycopg://partner_reports:SUBSTITUA@postgres:5432/partner_reports
POSTGRES_DB=partner_reports
POSTGRES_USER=partner_reports
POSTGRES_PASSWORD=SUBSTITUA
LOG_LEVEL=INFO
PDF_STORAGE_ROOT=/data/sources
REPORT_STORAGE_ROOT=/data/reports
PDF_FOUR_EYES=false
PDF_SYNTHETIC_CORRECTIONS=true
PDF_DATA_SCOPE=synthetic_only
# Em private_pilot, cada parceiro real é cadastrado e liberado em Gerenciar parceiros no portal.
SITE_ADDRESS=https://staging.exemplo.invalid
ACME_EMAIL=operacao@exemplo.invalid

PGHOST=postgres
PGPORT=5432
PGDATABASE=partner_reports
PGUSER=partner_reports
PGPASSWORD=SUBSTITUA
