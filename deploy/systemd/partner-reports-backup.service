[Unit]
Description=Partner Reports encrypted offsite backup
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/opt/partner-reports/deploy/compose.env
ConditionPathExists=/opt/partner-reports/deploy/restic.env

[Service]
Type=oneshot
WorkingDirectory=/opt/partner-reports
ExecStart=/usr/bin/docker compose --env-file deploy/compose.env -f compose.production.yml --profile backup run --rm backup
TimeoutStartSec=2h
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
