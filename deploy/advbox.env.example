# Copie para deploy/advbox.env no host, proteja com chmod 600 e monte somente no worker.
# Nunca registre, versione ou passe o token por argumento de linha de comando.
ADVBOX_API_BASE_URL=https://app.advbox.com.br/api/v1
ADVBOX_API_TOKEN=
ADVBOX_AUDIT_REQUESTS_PER_MINUTE=20
ADVBOX_AUDIT_TIMEOUT_SECONDS=15
ADVBOX_AUDIT_MAX_RETRIES=3
