# Copie para um arquivo protegido fora do Git e exponha-o somente aos
# serviços backup e restore-test. Nunca registre valores reais neste modelo.
# Cloudflare R2 via API S3. Use o endpoint da conta, um bucket privado e um
# prefixo exclusivo para este repositório.
RESTIC_REPOSITORY=s3:https://SUBSTITUA_ACCOUNT_ID.r2.cloudflarestorage.com/SUBSTITUA_BUCKET/restic
RESTIC_PASSWORD_FILE=/run/restic/password
AWS_ACCESS_KEY_ID=SUBSTITUA
AWS_SECRET_ACCESS_KEY=SUBSTITUA
AWS_DEFAULT_REGION=auto
