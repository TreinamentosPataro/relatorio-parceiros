<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Parceiros · Plataforma interna</title>
  <link rel="stylesheet" href="/portal/assets.css">
</head>
<body>
  <a class="skip-link" href="#main">Ir para o conteúdo</a>
  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="/portal/partners"><span class="brand-mark" aria-hidden="true">P</span><span>Relatórios<span class="brand-sub">/ Parceiros</span></span></a>
      <div class="header-actions"><span class="user-label">{{ user.display_name or 'Usuário interno' }}</span><form method="post" action="/portal/logout"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="text-button" type="submit">Sair</button></form></div>
    </div>
  </header>
  <main class="container" id="main">
    <div class="page-heading"><div><p class="eyebrow">Visão geral</p><h1>Parceiros</h1><p class="muted">Encontre a carteira e consulte a versão disponível de cada relatório.</p>{% if is_admin %}<p><a class="button button-primary" href="/portal/imports/new">Enviar PDF da carteira</a></p>{% endif %}</div><div class="count-card"><span class="count-number">{{ total }}</span><span>parceiro{{ 's' if total != 1 else '' }} encontrado{{ 's' if total != 1 else '' }}</span></div></div>
    {% if demo %}<div class="notice" role="status"><strong>Ambiente de prévia sintética.</strong> Nenhum dado real ou relatório externo está publicado.</div>{% endif %}
    <section class="panel filters" aria-label="Busca e filtros">
      <form method="get" action="/portal/partners" class="filter-form">
        <div class="field field-search"><label for="q">Buscar parceiro</label><input id="q" name="q" value="{{ query }}" maxlength="100" placeholder="Nome ou código técnico"></div>
        <div class="field"><label for="status">Situação do relatório</label><select id="status" name="status"><option value="todos" {% if status == 'todos' %}selected{% endif %}>Todas as situações</option>{% for item in ['atualizado', 'desatualizado', 'gerando', 'erro', 'sem relatório'] %}<option value="{{ item }}" {% if status == item %}selected{% endif %}>{{ item|capitalize }}</option>{% endfor %}</select></div>
        <button class="button button-primary" type="submit">Aplicar filtros</button>
      </form>
    </section>
    <div class="section-heading"><div><p class="eyebrow">Carteira</p><h2>Lista de parceiros</h2></div><p class="sync-meta">Última sincronização global: <strong>{{ sync_at.strftime('%d/%m/%Y %H:%M') if sync_at else 'Não realizada' }}</strong></p></div>
    <section class="panel list-panel" aria-label="Resultados">
      {% if rows %}<div class="table-wrap"><table><thead><tr><th scope="col">Parceiro</th><th scope="col">Código</th><th scope="col">Relatório</th><th scope="col">Versão</th><th scope="col">Ação</th></tr></thead><tbody>
      {% for row in rows %}<tr><td data-label="Parceiro"><a class="partner-link" href="/portal/partners/{{ row.partner.id }}">{{ row.partner.name }}</a></td><td data-label="Código" class="mono">{{ row.partner.external_id }}</td><td data-label="Relatório"><span class="status-pill">{{ row.status }}</span></td><td data-label="Versão">{% if row.version %}v{{ row.version.version }} · {{ row.version.generated_at.strftime('%d/%m/%Y') }}{% else %}—{% endif %}</td><td data-label="Ação"><a class="row-action" href="/portal/partners/{{ row.partner.id }}">Abrir detalhe <span aria-hidden="true">→</span></a></td></tr>{% endfor %}
      </tbody></table></div>{% else %}<div class="empty-state"><span aria-hidden="true">⌕</span><h3>Nenhum parceiro encontrado</h3><p>Altere a busca ou o filtro de situação.</p></div>{% endif %}
    </section>
    <nav class="pagination" aria-label="Paginação"><span>Página {{ page }} de {{ total_pages }}</span><div>{% if page > 1 %}<a href="?q={{ query|urlencode }}&status={{ status|urlencode }}&page={{ page - 1 }}">Anterior</a>{% endif %}{% if page < total_pages %}<a href="?q={{ query|urlencode }}&status={{ status|urlencode }}&page={{ page + 1 }}">Próxima</a>{% endif %}</div></nav>
  </main>
  <footer class="site-footer"><div class="container">Relatórios de parceiros · Acesso interno</div></footer>
</body>
</html>
