<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Relatórios · Plataforma interna</title>
  <link rel="stylesheet" href="/portal/assets.css">
</head>
<body>
  {% include "_header.html.j2" %}
  <main class="container" id="main">
    <div class="page-heading"><div><p class="eyebrow">Relatórios</p><h1>Parceiros</h1><p class="muted">Abra um parceiro para ver o relatório atual ou envie um PDF novo.</p></div>{% if is_admin %}<a class="button button-primary" href="/portal/imports/new">Novo relatório</a>{% endif %}</div>
    {% if demo %}<div class="notice" role="status"><strong>Ambiente de prévia sintética.</strong> Nenhum dado real ou relatório externo está publicado.</div>{% endif %}
    <section class="panel filters" aria-label="Busca e filtros">
      <form method="get" action="/portal/partners" class="filter-form">
        <div class="field field-search"><label for="q">Buscar parceiro</label><input id="q" name="q" value="{{ query }}" maxlength="100" placeholder="Nome do parceiro"></div>
        <div class="field"><label for="status">Situação do relatório</label><select id="status" name="status"><option value="todos" {% if status == 'todos' %}selected{% endif %}>Todas as situações</option>{% for item in ['atualizado', 'desatualizado', 'gerando', 'erro', 'sem relatório'] %}<option value="{{ item }}" {% if status == item %}selected{% endif %}>{{ item|capitalize }}</option>{% endfor %}</select></div>
        <button class="button button-secondary" type="submit">Buscar</button>
      </form>
    </section>
    <div class="section-heading"><h2>{{ total }} parceiro{{ 's' if total != 1 else '' }}</h2></div>
    <section class="panel list-panel" aria-label="Resultados">
      {% if rows %}<div class="table-wrap"><table><thead><tr><th scope="col">Parceiro</th><th scope="col">Relatório</th><th scope="col">Último relatório</th><th scope="col"><span class="visually-hidden">Ação</span></th></tr></thead><tbody>
      {% for row in rows %}<tr><td data-label="Parceiro"><a class="partner-link" href="/portal/partners/{{ row.partner.id }}">{{ row.partner.name }}</a></td><td data-label="Relatório"><span class="status-pill">{{ row.status|capitalize }}</span></td><td data-label="Último relatório">{% if row.version %}{{ row.version.generated_at|data }}{% else %}—{% endif %}</td><td data-label="Ação"><a class="row-action" href="/portal/partners/{{ row.partner.id }}">Abrir <span aria-hidden="true">→</span></a></td></tr>{% endfor %}
      </tbody></table></div>{% else %}<div class="empty-state"><span aria-hidden="true">⌕</span><h3>Nenhum parceiro encontrado</h3><p>{% if query or status != 'todos' %}Altere a busca ou o filtro de situação.{% else %}Cadastre e libere parceiros em “Parceiros”, no menu.{% endif %}</p></div>{% endif %}
    </section>
    <nav class="pagination" aria-label="Paginação"><span>Página {{ page }} de {{ total_pages }}</span><div>{% if page > 1 %}<a href="?q={{ query|urlencode }}&status={{ status|urlencode }}&page={{ page - 1 }}">Anterior</a>{% endif %}{% if page < total_pages %}<a href="?q={{ query|urlencode }}&status={{ status|urlencode }}&page={{ page + 1 }}">Próxima</a>{% endif %}</div></nav>
  </main>
  <footer class="site-footer"><div class="container">Relatórios de parceiros · Acesso interno</div></footer>
</body>
</html>
