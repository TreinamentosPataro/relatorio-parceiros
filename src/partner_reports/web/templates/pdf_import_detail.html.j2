<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">{% if stage in ('processing', 'generating') %}<meta http-equiv="refresh" content="15">{% endif %}<title>Envio · {{ partner.name }}</title><link rel="stylesheet" href="/portal/assets.css"></head><body>
{% include "_header.html.j2" %}
{% set issue_text = {
  'unmatched': ('Não encontrado no Advbox', 'Confira se o número ou a pasta está igual no Advbox e clique em “Conferir de novo”.'),
  'ambiguous': ('Mais de um processo no Advbox com esta identificação', 'Ajuste o número ou a pasta no Advbox para que fique único e clique em “Conferir de novo”.'),
  'duplicate_source': ('Aparece repetido no PDF', 'Exporte o PDF de novo no Advbox e faça um novo envio.'),
  'invalid_identifier': ('Número do processo em formato inválido', 'Corrija o número no Advbox, exporte o PDF de novo e faça um novo envio.'),
} %}
{% set steps = [('received', 'Envio recebido'), ('check', 'Conferência no Advbox'), ('approve', 'Aprovação'), ('report', 'Relatório pronto')] %}
{% set position = {'processing': 1, 'failed': 1, 'issues': 2, 'blocked': 2, 'ready': 2, 'approved': 3, 'generating': 3, 'generation_failed': 3, 'done': 4, 'rejected': 0, 'superseded': 0}[stage] %}
<main class="container" id="main">
  <a class="back-link" href="/portal/partners/{{ partner.id }}">← {{ partner.name }}</a>
  <div class="page-heading compact-heading"><div><p class="eyebrow">Envio de {{ batch.created_at|datahora }}</p><h1>{{ partner.name }}</h1><p class="muted">Período {{ batch.period_start|data }} a {{ batch.period_end|data }}</p></div></div>
  {% if repeated %}<div class="notice" role="status"><strong>Este PDF já tinha sido enviado.</strong> Veja abaixo a situação do envio.</div>{% endif %}
  {% if notice %}<div class="notice" role="alert">{{ notice }}</div>{% endif %}
  {% if position %}<ol class="flow-steps" aria-label="Etapas">{% for key, label in steps %}<li class="{% if loop.index < position or stage == 'done' %}is-done{% elif loop.index == position %}is-current{% endif %}" {% if loop.index == position %}aria-current="step"{% endif %}><span class="flow-mark" aria-hidden="true"></span><span class="flow-label">{{ label }}</span></li>{% endfor %}</ol>{% endif %}

{% set tone = {'processing': 'working', 'generating': 'working', 'failed': 'alert', 'generation_failed': 'alert', 'issues': 'alert', 'blocked': 'alert', 'ready': 'ok', 'done': 'ok', 'approved': 'ok'}.get(stage, 'neutral') %}
  <section class="panel flow-panel tone-{{ tone }}" aria-live="polite"><span class="flow-icon" aria-hidden="true"></span><div class="flow-body">
  {% if stage == 'processing' %}
    <h2>Conferindo o PDF no Advbox</h2>
    <p>Estamos lendo os processos do PDF e conferindo cada um no Advbox. Isso costuma levar alguns minutos.</p>
    <p class="muted">Esta página se atualiza sozinha.</p>
  {% elif stage == 'failed' %}
    <h2>Não foi possível conferir este PDF</h2>
    <p>O processamento automático falhou depois de várias tentativas. Isso costuma ser instabilidade momentânea do Advbox.</p>
    <div class="action-group">
      <form method="post" action="/portal/imports/{{ batch.id }}/review/reprocess"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="revision" value="{{ batch.review_revision }}"><input type="hidden" name="confirm" value="yes"><button class="button button-primary" type="submit">Tentar novamente</button></form>
      {% if batch.state in ('quarantined', 'needs_review') %}<form method="post" action="/portal/imports/{{ batch.id }}/review/reject"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="revision" value="{{ batch.review_revision }}"><input type="hidden" name="confirm" value="yes"><button class="button button-secondary" type="submit">Descartar envio</button></form>{% endif %}
    </div>
  {% elif stage == 'issues' %}
    <h2>{{ issues|length }} processo{{ 's' if issues|length != 1 else '' }} precisa{{ 'm' if issues|length != 1 else '' }} de correção</h2>
    <p>{{ matched }} de {{ items|length }} processos do PDF foram encontrados no Advbox. Corrija os itens abaixo para liberar o relatório.</p>
    <div class="table-wrap"><table><thead><tr><th scope="col">Página do PDF</th><th scope="col">Processo / pasta</th><th scope="col">Problema</th><th scope="col">O que fazer</th></tr></thead><tbody>
    {% for item, entry in issues %}<tr><td data-label="Página">{{ entry.source_page_start if entry else '—' }}</td><td data-label="Processo / pasta" class="mono">{% if entry and entry.process_number_normalized %}{{ entry.process_number_normalized|cnj }}{% elif entry and entry.folder_exact %}Pasta {{ entry.folder_exact }}{% else %}Sem número{% endif %}</td><td data-label="Problema">{{ issue_text.get(item.status, ('Precisa de conferência', ''))[0] }}</td><td data-label="O que fazer">{{ issue_text.get(item.status, ('', 'Confira o processo no Advbox.'))[1] }}</td></tr>{% endfor %}
    </tbody></table></div>
    <div class="action-group">
      <form method="post" action="/portal/imports/{{ batch.id }}/review/reprocess"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="revision" value="{{ batch.review_revision }}"><input type="hidden" name="confirm" value="yes"><button class="button button-primary" type="submit">Conferir de novo</button></form>
      <form method="post" action="/portal/imports/{{ batch.id }}/review/reject"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="revision" value="{{ batch.review_revision }}"><input type="hidden" name="confirm" value="yes"><button class="button button-secondary" type="submit">Descartar envio</button></form>
    </div>
  {% elif stage == 'blocked' %}
    <h2>Não é possível aprovar agora</h2>
    <p>{% if not items %}Nenhum processo foi encontrado neste PDF. Confira se o arquivo exportado é o relatório do módulo Parceiros.{% else %}Há outro envio aprovado para o mesmo período ou uma conferência em andamento. Atualize a página em alguns minutos.{% endif %}</p>
    <div class="action-group"><form method="post" action="/portal/imports/{{ batch.id }}/review/reject"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="revision" value="{{ batch.review_revision }}"><input type="hidden" name="confirm" value="yes"><button class="button button-secondary" type="submit">Descartar envio</button></form></div>
  {% elif stage == 'ready' %}
    <h2>Tudo certo para gerar o relatório</h2>
    <p>Os {{ matched }} processo{{ 's' if matched != 1 else '' }} do PDF foram encontrados no Advbox.</p>
    {% include "_percentage.html.j2" %}
    <div class="action-group">
      <form method="post" action="/portal/imports/{{ batch.id }}/approve"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="revision" value="{{ batch.review_revision }}"><input type="hidden" name="confirm" value="yes"><button class="button button-primary" type="submit">Aprovar e gerar relatório</button></form>
      <form method="post" action="/portal/imports/{{ batch.id }}/review/reject"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="revision" value="{{ batch.review_revision }}"><input type="hidden" name="confirm" value="yes"><button class="button button-secondary" type="submit">Descartar envio</button></form>
    </div>
  {% elif stage == 'approved' %}
    <h2>Envio aprovado</h2>
    <p>O relatório ainda não foi gerado para este envio.</p>
    <div class="action-group"><form method="post" action="/portal/imports/{{ batch.id }}/generate"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="confirm" value="yes"><button class="button button-primary" type="submit">Gerar relatório</button></form></div>
  {% elif stage == 'generating' %}
    <h2>Gerando o relatório</h2>
    <p>Isso costuma levar menos de um minuto. Esta página se atualiza sozinha.</p>
  {% elif stage == 'generation_failed' %}
    <h2>A geração do relatório falhou</h2>
    <p>Tente de novo. Se a falha continuar, avise o responsável técnico.</p>
    <div class="action-group"><form method="post" action="/portal/imports/{{ batch.id }}/generate"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="confirm" value="yes"><button class="button button-primary" type="submit">Gerar novamente</button></form></div>
  {% elif stage == 'done' %}
    <h2>Relatório pronto</h2>
    <p>Gerado em {{ version.generated_at|datahora }}{% if version.partnership_percentage is not none %} com {{ version.partnership_percentage|percentual }}% de parceria{% endif %}. Confira o conteúdo antes de enviar ao parceiro.</p>
    <div class="action-group"><a class="button button-primary" href="/portal/partners/{{ partner.id }}/versions/{{ version.id }}/html">Ver relatório</a><a class="button button-secondary" href="/portal/partners/{{ partner.id }}/versions/{{ version.id }}/pdf">Baixar PDF</a></div>
    {% if version.partnership_percentage is not none and version.partnership_percentage != partner.partnership_percentage %}
    <div class="notice" role="status"><strong>O percentual do parceiro mudou para {{ partner.partnership_percentage|percentual }}%.</strong> Gere de novo para atualizar a prestação de contas; a versão atual continua no histórico.</div>
    <div class="action-group"><form method="post" action="/portal/imports/{{ batch.id }}/generate"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="confirm" value="yes"><button class="button button-primary" type="submit">Gerar de novo com {{ partner.partnership_percentage|percentual }}%</button></form></div>
    {% endif %}
  {% elif stage == 'rejected' %}
    <h2>Envio descartado</h2>
    <p>Este envio não gera relatório. Para continuar, faça um novo envio com o PDF exportado do Advbox.</p>
    <div class="action-group"><a class="button button-primary" href="/portal/imports/new?parceiro={{ partner.id }}">Novo relatório</a></div>
  {% else %}
    <h2>Envio substituído</h2>
    <p>Um envio mais recente do mesmo período substituiu este.</p>
    <div class="action-group"><a class="button button-primary" href="/portal/partners/{{ partner.id }}">Ver relatórios do parceiro</a></div>
  {% endif %}
  </div></section>

  <details class="technical-details">
    <summary>Detalhes técnicos</summary>
    <div class="table-wrap"><table class="metadata-table"><tbody>
      <tr><th scope="row">Situação</th><td data-label="Situação">{{ batch.state|estado }} · {{ batch.processing_status|processamento }}{% if batch.processing_error_code %} · <span class="mono">{{ batch.processing_error_code }}</span>{% endif %}{% if batch.processing_attempt_count %} · tentativa {{ batch.processing_attempt_count }} de 3{% endif %}</td></tr>
      <tr><th scope="row">Páginas / itens</th><td data-label="Páginas / itens">{{ source.page_count }} / {{ batch.parsed_item_count if batch.parsed_item_count is not none else 'pendente' }}</td></tr>
      <tr><th scope="row">Identificador do envio</th><td data-label="Envio" class="mono">{{ batch.id }}</td></tr>
      {% if run %}<tr><th scope="row">Conferência</th><td data-label="Conferência">{{ run.result_total }} itens · {{ run.matched_count }} encontrados · {{ run.unmatched_count }} não encontrados · {{ run.ambiguous_count }} ambíguos · {{ run.duplicate_source_count }} repetidos · {{ run.invalid_identifier_count }} inválidos</td></tr>{% endif %}
    </tbody></table></div>
    {% if corrections_enabled %}{% for item in items if item.status in ('unmatched', 'ambiguous') %}<form method="post" action="/portal/imports/{{ batch.id }}/review/correct" class="review-form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="revision" value="{{ batch.review_revision }}"><input type="hidden" name="item_id" value="{{ item.id }}"><label for="id-{{ item.id }}">ID existente para o item {{ loop.index }}</label><select id="id-{{ item.id }}" name="advbox_id" required><option value="">Selecione</option>{% for technical_id in technical_ids %}<option value="{{ technical_id }}">{{ technical_id }}</option>{% endfor %}</select><label><input type="checkbox" name="confirm" value="yes" required> Confirmo o ID técnico</label><button class="button button-secondary" type="submit">Corrigir</button></form>{% endfor %}{% endif %}
    {% if reviews %}<div class="table-wrap"><table><thead><tr><th scope="col">Quando</th><th scope="col">Decisão</th></tr></thead><tbody>{% for review in reviews %}<tr><td data-label="Quando">{{ review.created_at|datahora }}</td><td data-label="Decisão">{{ review.decision }} / {{ review.reason_code }}</td></tr>{% endfor %}</tbody></table></div>{% endif %}
  </details>
</main><footer class="site-footer"><div class="container">Relatórios de parceiros · Acesso interno</div></footer></body></html>
