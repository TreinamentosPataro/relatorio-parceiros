<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Revisão da importação</title><link rel="stylesheet" href="/portal/assets.css"></head><body>
<a class="skip-link" href="#main">Ir para o conteúdo</a><header class="site-header"><div class="header-inner"><a class="brand" href="/portal/partners"><span class="brand-mark" aria-hidden="true">P</span><span>Relatórios<span class="brand-sub">/ Parceiros</span></span></a><div class="header-actions"><span class="user-label">{{ user.display_name or 'Usuário interno' }}</span><form method="post" action="/portal/logout"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="text-button" type="submit">Sair</button></form></div></div></header>
<main class="container" id="main"><a class="back-link" href="/portal/imports">← Todas as importações</a><div class="page-heading"><div><p class="eyebrow">Importação privada</p><h1>Revisão do lote</h1><p class="muted">{% if batch.state == 'quarantined' %}O documento ainda não foi interpretado, reconciliado ou publicado.{% else %}Esta decisão não publica um relatório.{% endif %}</p></div><span class="status-pill status-large">{{ batch.state }}</span></div>
<section class="panel list-panel" aria-label="Metadados técnicos"><div class="table-wrap"><table class="metadata-table"><tbody><tr><th scope="row">Parceiro</th><td data-label="Parceiro">{{ partner.name }}</td></tr><tr><th scope="row">Período</th><td data-label="Período">{{ batch.period_start.strftime('%d/%m/%Y') }}–{{ batch.period_end.strftime('%d/%m/%Y') }}</td></tr><tr><th scope="row">Recebido</th><td data-label="Recebido">{{ batch.created_at.strftime('%d/%m/%Y %H:%M') }}</td></tr><tr><th scope="row">Páginas / itens</th><td data-label="Páginas / itens">{{ source.page_count }} / {{ batch.parsed_item_count if batch.parsed_item_count is not none else 'pendente' }}</td></tr><tr><th scope="row">Identificador do lote</th><td data-label="Lote" class="mono">{{ batch.id }}</td></tr><tr><th scope="row">Revisão</th><td data-label="Revisão">{{ batch.review_revision }}</td></tr></tbody></table></div></section>
{% if synthetic_generation %}<section class="panel action-panel" aria-label="Gerar prévia sintética"><div><p class="eyebrow">Relatório privado</p><h2>Gerar prévia do lote aprovado</h2><p class="muted">Usa apenas dados estruturados da fotografia sintética. Conteúdo de negócio e publicação real seguem pendentes.</p></div><form method="post" action="/portal/imports/{{ batch.id }}/generate" class="review-form"><input type="hidden" name="csrf" value="{{ csrf }}"><label><input type="checkbox" name="confirm" value="yes" required> Confirmo a geração sintética</label><button class="button button-primary" type="submit">Solicitar relatório</button></form></section>{% endif %}
{% if run %}<section class="history-section"><div class="section-heading"><h2>Reconciliação</h2><p class="muted">{{ run.result_total }} itens · {{ run.matched_count }} correspondentes · {{ run.unmatched_count }} sem correspondência · {{ run.ambiguous_count }} ambíguos · {{ run.duplicate_source_count }} repetidos · {{ run.invalid_identifier_count }} inválidos</p></div><div class="panel list-panel"><div class="table-wrap"><table><thead><tr><th>Item técnico</th><th>Estado</th><th>Método</th><th>ID técnico</th><th>Motivo</th><th>Correção</th></tr></thead><tbody>
{% for item in items %}<tr><td data-label="Item" class="mono">{{ item.id }}</td><td data-label="Estado">{{ item.status }}</td><td data-label="Método">{{ item.method or '—' }}</td><td data-label="ID técnico">{{ item.matched_advbox_id if item.matched_advbox_id is not none else '—' }}</td><td data-label="Motivo">{{ item.reason_code or '—' }}</td><td data-label="Correção">{% if corrections_enabled and item.status in ('unmatched', 'ambiguous') %}<form method="post" action="/portal/imports/{{ batch.id }}/review/correct" class="review-form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="revision" value="{{ batch.review_revision }}"><input type="hidden" name="item_id" value="{{ item.id }}"><label for="id-{{ item.id }}">ID existente</label><select id="id-{{ item.id }}" name="advbox_id" required><option value="">Selecione</option>{% for technical_id in technical_ids %}<option value="{{ technical_id }}">{{ technical_id }}</option>{% endfor %}</select><label><input type="checkbox" name="confirm" value="yes" required> Confirmo o ID técnico</label><button class="button button-secondary" type="submit">Corrigir</button></form>{% else %}—{% endif %}</td></tr>{% endfor %}
</tbody></table></div></div></section>{% endif %}
{% if batch.state in ('needs_review', 'quarantined', 'parsing') %}<section class="history-section"><h2>Decisões</h2><div class="review-actions">{% if batch.state == 'needs_review' %}
<form method="post" action="/portal/imports/{{ batch.id }}/review/approve" class="panel review-form"><h3>Aprovar lote</h3><p class="muted">{% if approval_blocked %}Aprovação bloqueada: confira pendências, quatro olhos e lote anterior.{% else %}Exige classificação completa e nenhuma pendência.{% endif %}</p><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="revision" value="{{ batch.review_revision }}"><label><input type="checkbox" name="confirm" value="yes" required {% if approval_blocked %}disabled{% endif %}> Conferi a reconciliação</label><button class="button button-primary" type="submit" {% if approval_blocked %}disabled{% endif %}>Aprovar</button></form>
<form method="post" action="/portal/imports/{{ batch.id }}/review/reprocess" class="panel review-form"><h3>Solicitar reprocessamento</h3><p class="muted">{% if pending_reprocess %}Solicitação pendente para esta reconciliação.{% else %}Registra a solicitação. A execução depende de uma rotina posterior.{% endif %}</p><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="revision" value="{{ batch.review_revision }}"><label><input type="checkbox" name="confirm" value="yes" required {% if pending_reprocess %}disabled{% endif %}> Solicito nova reconciliação</label><button class="button button-secondary" type="submit" {% if pending_reprocess %}disabled{% endif %}>Solicitar</button></form>
{% if replacements %}<form method="post" action="/portal/imports/{{ batch.id }}/review/supersede" class="panel review-form"><h3>Substituir lote aprovado</h3><label for="old_batch_id">Lote anterior</label><select id="old_batch_id" name="old_batch_id" required><option value="">Selecione</option>{% for old in replacements %}<option value="{{ old.id }}">{{ old.id }}</option>{% endfor %}</select><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="revision" value="{{ batch.review_revision }}"><label><input type="checkbox" name="confirm" value="yes" required> Confirmo a substituição</label><button class="button button-secondary" type="submit">Substituir e aprovar</button></form>{% endif %}{% endif %}
<form method="post" action="/portal/imports/{{ batch.id }}/review/reject" class="panel review-form"><h3>Rejeitar lote</h3><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="revision" value="{{ batch.review_revision }}"><label><input type="checkbox" name="confirm" value="yes" required> Confirmo a rejeição</label><button class="button button-secondary" type="submit">Rejeitar</button></form></div></section>{% endif %}
<section class="history-section"><h2>Histórico auditado</h2><div class="panel list-panel"><div class="table-wrap"><table><thead><tr><th>Quando</th><th>Ator técnico</th><th>Ação / motivo</th><th>Item</th><th>Método</th><th>Antes → depois</th></tr></thead><tbody>{% for review in reviews %}<tr><td data-label="Quando">{{ review.created_at.strftime('%d/%m/%Y %H:%M') }}</td><td data-label="Ator" class="mono">{{ review.reviewer_user_id }}</td><td data-label="Ação">{{ review.decision }} / {{ review.reason_code }}</td><td data-label="Item" class="mono">{{ review.reconciliation_item_id or '—' }}</td><td data-label="Método">{{ review.method or '—' }}</td><td data-label="Antes e depois">{{ review.before_advbox_id if review.before_advbox_id is not none else '—' }} → {{ review.after_advbox_id if review.after_advbox_id is not none else '—' }}</td></tr>{% else %}<tr><td colspan="6">Ainda não há decisões.</td></tr>{% endfor %}</tbody></table></div></div></section>
</main><footer class="site-footer"><div class="container">Relatórios de parceiros · Acesso interno</div></footer></body></html>
