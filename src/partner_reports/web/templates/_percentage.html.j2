{% if partner_admin_link|default(false) %}<form method="post" action="/portal/admin/partners/{{ partner.id }}/percentage" class="inline-form percentage-line"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="back" value="/portal/imports/{{ batch.id }}"><label for="pct-batch">Percentual da parceria</label><input id="pct-batch" name="percentage" inputmode="decimal" value="{{ partner.partnership_percentage|percentual }}" size="6" required><span>%</span><button class="button button-secondary" type="submit">Alterar</button></form>{% else %}<p class="percentage-line">Percentual da parceria: <strong>{{ partner.partnership_percentage|percentual }}%</strong></p>{% endif %}
