<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Gerenciar parceiros · Plataforma interna</title>
  <link rel="stylesheet" href="/portal/assets.css">
</head>
<body>
  {% include "_header.html.j2" %}
  <main class="container" id="main">
    <div class="page-heading detail-heading"><div><p class="eyebrow">Administração</p><h1>Gerenciar parceiros</h1><p class="muted">Cadastre o parceiro e ative-o para que apareça no envio de PDF. Todo parceiro começa com 10% de parceria; ajuste aqui os que têm outro percentual.</p></div><div class="count-card"><span class="count-number">{{ enabled }}</span><span>ativo{{ 's' if enabled != 1 else '' }} de {{ partners|length }}</span></div></div>
    <div class="notice" role="status"><strong>Somente parceiros ativos</strong> aparecem no envio de PDF e na lista de relatórios. Suspender esconde o parceiro sem apagar envios nem relatórios.</div>
    <section class="panel filters" aria-label="Cadastrar parceiro">
      <form method="post" action="/portal/admin/partners" class="filter-form">
        <input type="hidden" name="csrf" value="{{ csrf }}">
        <div class="field field-search"><label for="name">Nome do parceiro (uso interno)</label><input id="name" name="name" required minlength="2" maxlength="{{ max_name }}" autocomplete="off"></div>
        <button class="button button-primary" type="submit">Cadastrar</button>
      </form>
      {% if error %}<p class="form-error" role="alert">{{ error }}</p>{% endif %}
    </section>
    <div class="section-heading"><div><h2>Parceiros cadastrados</h2></div><p class="sync-meta">O código técnico é gerado pelo sistema e não identifica o parceiro fora do portal.</p></div>
    <section class="panel list-panel" aria-label="Parceiros cadastrados">
      {% if partners %}<div class="table-wrap"><table><thead><tr><th scope="col">Parceiro</th><th scope="col">Percentual da parceria</th><th scope="col">Situação</th><th scope="col">Ação</th></tr></thead><tbody>
      {% for partner in partners %}<tr id="p-{{ partner.id }}"><td data-label="Parceiro">{{ partner.name }}<br><span class="mono muted">{{ partner.external_id }}</span></td><td data-label="Percentual"><form method="post" action="/portal/admin/partners/{{ partner.id }}/percentage" class="inline-form"><input type="hidden" name="csrf" value="{{ csrf }}"><label class="visually-hidden" for="pct-{{ partner.id }}">Percentual de {{ partner.name }}</label><input id="pct-{{ partner.id }}" name="percentage" inputmode="decimal" value="{{ partner.partnership_percentage|percentual }}" size="6" required><button class="button button-secondary" type="submit">Salvar</button></form></td><td data-label="Situação"><span class="status-pill">{{ 'ativo' if partner.pilot_enabled else 'suspenso' }}</span></td><td data-label="Ação"><form method="post" action="/portal/admin/partners/{{ partner.id }}/pilot/{{ 'disable' if partner.pilot_enabled else 'enable' }}" class="review-form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="confirm" value="yes"><button class="button {{ 'button-secondary' if partner.pilot_enabled else 'button-primary' }}" type="submit">{{ 'Suspender' if partner.pilot_enabled else 'Ativar' }}</button></form></td></tr>{% endfor %}
      </tbody></table></div>{% else %}<div class="empty-state"><span aria-hidden="true">＋</span><h3>Nenhum parceiro cadastrado</h3><p>Use o formulário acima para cadastrar o primeiro.</p></div>{% endif %}
    </section>
    <p class="pagination"></p>
  </main>
  <footer class="site-footer"><div class="container">Relatórios de parceiros · Acesso interno</div></footer>
</body>
</html>
