<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Importações</title><link rel="stylesheet" href="/portal/assets.css"></head><body>
<a class="skip-link" href="#main">Ir para o conteúdo</a><header class="site-header"><div class="header-inner"><a class="brand" href="/portal/partners"><span class="brand-mark" aria-hidden="true">P</span><span>Relatórios<span class="brand-sub">/ Parceiros</span></span></a><div class="header-actions"><span class="user-label">{{ user.display_name or 'Usuário interno' }}</span><a class="text-button" href="/portal/account/password">Alterar senha</a><form method="post" action="/portal/logout"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="text-button" type="submit">Sair</button></form></div></div></header>
<main class="container" id="main"><a class="back-link" href="/portal/partners">← Voltar aos parceiros</a><div class="page-heading"><div><p class="eyebrow">Importação privada</p><h1>Lotes de PDF</h1><p class="muted">Metadados e classificações técnicas para revisão interna.</p></div><a class="button button-primary" href="/portal/imports/new">Novo lote</a></div>
<section class="panel filters"><form method="get" action="/portal/imports" class="filter-form"><div class="field"><label for="partner_id">Parceiro</label><select id="partner_id" name="partner_id"><option value="">Todos</option>{% for partner in partners %}<option value="{{ partner.id }}" {% if partner_id == partner.id %}selected{% endif %}>{{ partner.name }}</option>{% endfor %}</select></div><div class="field"><label for="state">Estado</label><select id="state" name="state">{% for value in ('all','uploaded','quarantined','parsing','parsed','reconciling','needs_review','approved','rejected','failed','superseded') %}<option value="{{ value }}" {% if state == value %}selected{% endif %}>{{ value|estado }}</option>{% endfor %}</select></div><div class="field"><label for="period_start">De</label><input id="period_start" type="date" name="period_start" value="{{ period_start.isoformat() if period_start else '' }}"></div><div class="field"><label for="period_end">Até</label><input id="period_end" type="date" name="period_end" value="{{ period_end.isoformat() if period_end else '' }}"></div><button class="button button-secondary" type="submit">Filtrar</button></form></section>
<section class="history-section"><div class="section-heading"><h2>{{ total }} lotes</h2><p class="muted">Página {{ page }} de {{ pages }}</p></div><div class="panel list-panel"><div class="table-wrap"><table><thead><tr><th>Parceiro</th><th>Período</th><th>Recebido</th><th>Estado</th><th>Itens / correspondentes / pendências</th><th></th></tr></thead><tbody>{% for batch, partner in rows %}{% set run = runs[batch.id] %}<tr><td data-label="Parceiro">{{ partner.name }}</td><td data-label="Período">{{ batch.period_start|data }}–{{ batch.period_end|data }}</td><td data-label="Recebido">{{ batch.created_at|datahora }}</td><td data-label="Estado"><span class="status-pill status-exact">{{ batch.state|estado }}</span></td><td data-label="Contagens">{{ run.result_total if run else (batch.parsed_item_count if batch.parsed_item_count is not none else '—') }} / {{ run.matched_count if run else '—' }} / {{ (run.unmatched_count + run.ambiguous_count + run.duplicate_source_count + run.invalid_identifier_count) if run else '—' }}</td><td data-label="Ação"><a class="row-action" href="/portal/imports/{{ batch.id }}">Revisar</a></td></tr>{% else %}<tr><td colspan="6">Nenhum lote encontrado.</td></tr>{% endfor %}</tbody></table></div></div>
<nav class="pagination" aria-label="Páginas"><div>{% if page > 1 %}<a href="?page={{ page - 1 }}&state={{ state }}{% if partner_id %}&partner_id={{ partner_id }}{% endif %}{% if period_start %}&period_start={{ period_start }}{% endif %}{% if period_end %}&period_end={{ period_end }}{% endif %}">← Anterior</a>{% endif %}{% if page < pages %}<a href="?page={{ page + 1 }}&state={{ state }}{% if partner_id %}&partner_id={{ partner_id }}{% endif %}{% if period_start %}&period_start={{ period_start }}{% endif %}{% if period_end %}&period_end={{ period_end }}{% endif %}">Próxima →</a>{% endif %}</div></nav></section></main><footer class="site-footer"><div class="container">Relatórios de parceiros · Acesso interno</div></footer></body></html>
