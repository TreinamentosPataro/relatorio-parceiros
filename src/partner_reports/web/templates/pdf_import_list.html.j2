<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Envios · Plataforma interna</title><link rel="stylesheet" href="/portal/assets.css"></head><body>
{% include "_header.html.j2" %}
<main class="container" id="main"><div class="page-heading"><div><p class="eyebrow">Envios</p><h1>PDFs enviados</h1><p class="muted">Acompanhe cada envio até o relatório ficar pronto.</p></div><a class="button button-primary" href="/portal/imports/new">Novo relatório</a></div>
<section class="panel filters"><form method="get" action="/portal/imports" class="filter-form"><div class="field"><label for="partner_id">Parceiro</label><select id="partner_id" name="partner_id"><option value="">Todos</option>{% for partner in partners %}<option value="{{ partner.id }}" {% if partner_id == partner.id %}selected{% endif %}>{{ partner.name }}</option>{% endfor %}</select></div><div class="field"><label for="state">Situação</label><select id="state" name="state">{% for value in ('all','quarantined','needs_review','approved','rejected','superseded') %}<option value="{{ value }}" {% if state == value %}selected{% endif %}>{{ value|estado }}</option>{% endfor %}</select></div><button class="button button-secondary" type="submit">Filtrar</button></form></section>
<section class="history-section"><div class="section-heading"><h2>{{ total }} envio{{ 's' if total != 1 else '' }}</h2><p class="muted">Página {{ page }} de {{ pages }}</p></div><div class="panel list-panel"><div class="table-wrap"><table><thead><tr><th scope="col">Parceiro</th><th scope="col">Período</th><th scope="col">Enviado em</th><th scope="col">Situação</th><th scope="col">Processos encontrados</th><th scope="col"><span class="visually-hidden">Ação</span></th></tr></thead><tbody>{% for batch, partner in rows %}{% set run = runs[batch.id] %}<tr><td data-label="Parceiro">{{ partner.name }}</td><td data-label="Período">{{ batch.period_start|data }} a {{ batch.period_end|data }}</td><td data-label="Enviado em">{{ batch.created_at|datahora }}</td><td data-label="Situação"><span class="status-pill status-exact">{{ batch.state|estado }}</span></td><td data-label="Processos encontrados">{% if run %}{{ run.matched_count }} de {{ run.result_total }}{% else %}—{% endif %}</td><td data-label="Ação"><a class="row-action" href="/portal/imports/{{ batch.id }}">Abrir <span aria-hidden="true">→</span></a></td></tr>{% else %}<tr><td colspan="6">Nenhum envio encontrado.</td></tr>{% endfor %}</tbody></table></div></div>
<nav class="pagination" aria-label="Páginas"><div>{% if page > 1 %}<a href="?page={{ page - 1 }}&state={{ state }}{% if partner_id %}&partner_id={{ partner_id }}{% endif %}{% if period_start %}&period_start={{ period_start }}{% endif %}{% if period_end %}&period_end={{ period_end }}{% endif %}">← Anterior</a>{% endif %}{% if page < pages %}<a href="?page={{ page + 1 }}&state={{ state }}{% if partner_id %}&partner_id={{ partner_id }}{% endif %}{% if period_start %}&period_start={{ period_start }}{% endif %}{% if period_end %}&period_end={{ period_end }}{% endif %}">Próxima →</a>{% endif %}</div></nav></section></main><footer class="site-footer"><div class="container">Relatórios de parceiros · Acesso interno</div></footer></body></html>
