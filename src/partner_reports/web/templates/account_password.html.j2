<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Alterar senha · Relatórios de parceiros</title>
  <link rel="stylesheet" href="/portal/assets.css">
</head>
<body class="login-page">
  <main class="login-shell">
    <div class="brand-mark" aria-hidden="true">P</div>
    <p class="eyebrow">Minha conta</p>
    <h1>Alterar senha</h1>
    <p class="muted">Use no mínimo {{ min_length }} caracteres. Ao confirmar, as outras sessões abertas desta conta são encerradas.</p>
    {% if changed %}<p class="form-success" role="status">Senha alterada com sucesso.</p>{% endif %}
    {% if error %}<p class="form-error" role="alert">{{ error }}</p>{% endif %}
    <form method="post" action="/portal/account/password" class="login-form">
      <input type="hidden" name="csrf" value="{{ csrf }}">
      <input type="hidden" name="username" value="{{ login_name }}" autocomplete="username">
      <label for="current_password">Senha atual</label>
      <input id="current_password" name="current_password" type="password" autocomplete="current-password" maxlength="256" required autofocus>
      <label for="new_password">Nova senha</label>
      <input id="new_password" name="new_password" type="password" autocomplete="new-password" minlength="{{ min_length }}" maxlength="256" required>
      <label for="confirm_password">Confirme a nova senha</label>
      <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" minlength="{{ min_length }}" maxlength="256" required>
      <button class="button button-primary" type="submit">Alterar senha</button>
    </form>
    <p class="login-foot"><a href="/portal/partners">Voltar ao portal</a></p>
  </main>
</body>
</html>
