<!doctype html>
<html lang="pt-BR">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Novo relatório · Plataforma interna</title><link rel="stylesheet" href="/portal/assets.css"></head>
<body>
  {% include "_header.html.j2" %}
  <main class="container" id="main">
    <div class="page-heading"><div><p class="eyebrow">Novo relatório</p><h1>Enviar o PDF do parceiro</h1><p class="muted">No Advbox, abra o módulo Parceiros, exporte o relatório do parceiro em PDF e envie o arquivo aqui, sem editar.</p></div></div>
    {% if error %}<div class="notice" role="alert"><strong>Envio não concluído.</strong> {{ error }}</div>{% endif %}
    <section class="panel upload-panel" aria-label="Enviar PDF">
      <form method="post" action="/portal/imports/new" enctype="multipart/form-data" class="upload-form">
        <input type="hidden" name="csrf" value="{{ csrf }}">
        <div class="field upload-partner"><label for="partner_id">Parceiro</label><select id="partner_id" name="partner_id" required><option value="">Selecione</option>{% for partner in partners %}<option value="{{ partner.id }}" {% if selected == partner.id %}selected{% endif %}>{{ partner.name }}</option>{% endfor %}</select></div>
        <div class="field"><label for="period_month">Mês de referência</label><input id="period_month" name="period_month" type="month" value="{{ current_month }}" max="{{ current_month }}" required></div>
        <div class="field upload-file"><label for="source_pdf">PDF exportado do Advbox</label><input id="source_pdf" name="source_pdf" type="file" accept="application/pdf,.pdf" required><span class="field-hint">Até {{ max_mib }} MiB e 200 páginas, sem destaques ou comentários.</span></div>
        <button class="button button-primary upload-submit" type="submit">Enviar e conferir</button>
      </form>
    </section>
  </main><footer class="site-footer"><div class="container">Relatórios de parceiros · Acesso interno</div></footer>
</body>
</html>
