<!doctype html>
<html lang="pt-BR">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Detalhe do parceiro · Plataforma interna</title><link rel="stylesheet" href="/portal/assets.css"></head>
<body>
  <a class="skip-link" href="#main">Ir para o conteúdo</a>
  <header class="site-header"><div class="header-inner"><a class="brand" href="/portal/partners"><span class="brand-mark" aria-hidden="true">P</span><span>Relatórios<span class="brand-sub">/ Parceiros</span></span></a><div class="header-actions"><span class="user-label">{{ user.display_name or 'Usuário interno' }}</span><a class="text-button" href="/portal/account/password">Alterar senha</a><form method="post" action="/portal/logout"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="text-button" type="submit">Sair</button></form></div></div></header>
  <main class="container" id="main">
    <a class="back-link" href="/portal/partners">← Voltar aos parceiros</a>
    <div class="page-heading detail-heading"><div><p class="eyebrow">Detalhe da carteira</p><h1>{{ partner.name }}</h1><p class="muted mono">{{ partner.external_id }}</p></div><span class="status-pill status-large">{{ state }}</span></div>
    {% if demo %}<div class="notice" role="status"><strong>Prévia sintética.</strong> Arquivos de demonstração locais; nenhuma publicação real.</div>{% endif %}
    <div class="detail-grid">
      <section class="panel detail-card"><p class="eyebrow">Relatório</p><h2>Versão vigente</h2>{% if latest_valid and latest_valid.status in ['validated', 'published'] %}<p class="detail-value">v{{ latest_valid.version }}</p><p class="muted">Gerado em {{ latest_valid.generated_at|datahora }}</p><p class="muted">{% if latest_valid.pdf_batch_id %}Fonte: lote PDF aprovado e fotografia estruturada; regras de conteúdo pendentes{% else %}Fonte: prévia sintética{% endif %}</p>{% else %}<p class="detail-value">Indisponível</p><p class="muted">Ainda não há versão pronta para consulta.</p>{% endif %}</section>
      <section class="panel detail-card"><p class="eyebrow">Origem dos dados</p><h2>Sincronização</h2><p class="detail-value">{{ sync_at|data if sync_at else 'Pendente' }}</p><p class="muted">Última sincronização global registrada. Abrir o parceiro não consulta o Advbox.</p></section>
    </div>
    <section class="panel action-panel" aria-label="Ações do relatório"><div><p class="eyebrow">Ações</p><h2>Consultar relatório</h2><p class="muted">A versão disponível é servida do armazenamento configurado, sem extração em tempo real.</p></div><div class="action-group">{% if latest_valid and latest_valid.status in ['validated', 'published'] and demo %}<a class="button button-primary" href="/portal/partners/{{ partner.id }}/versions/{{ latest_valid.id }}/html">Visualizar HTML</a><a class="button button-secondary" href="/portal/partners/{{ partner.id }}/versions/{{ latest_valid.id }}/pdf">Baixar PDF</a>{% elif not latest_valid %}<form method="post" action="/portal/partners/{{ partner.id }}/open"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="button button-primary" type="submit">Solicitar geração</button></form>{% else %}<span class="muted">Armazenamento privado ainda não configurado.</span>{% endif %}{% if is_admin %}<form method="post" action="/portal/partners/{{ partner.id }}/regenerate"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="button button-secondary" type="submit">Regenerar apenas este parceiro</button></form>{% endif %}</div></section>
    <section class="history-section"><div class="section-heading"><div><p class="eyebrow">Auditoria</p><h2>Histórico de versões</h2></div><span class="muted">Até 20 versões recentes</span></div><div class="panel">{% if versions %}<div class="table-wrap"><table><thead><tr><th scope="col">Versão</th><th scope="col">Período</th><th scope="col">Gerada em</th><th scope="col">Estado</th><th scope="col">Fonte</th><th scope="col">Arquivos</th></tr></thead><tbody>{% for version in versions %}<tr><td data-label="Versão">v{{ version.version }}</td><td data-label="Período">{{ version.period_start|data }}–{{ version.period_end|data }}</td><td data-label="Gerada em">{{ version.generated_at|datahora }}</td><td data-label="Estado"><span class="status-pill">{{ version_labels.get(version.status, 'Pendente') }}</span></td><td data-label="Fonte">{% if version.pdf_batch_id %}Lote PDF aprovado; conteúdo pendente{% else %}Prévia sintética{% endif %}</td><td data-label="Arquivos">{% if version.status in ['validated', 'published'] and demo %}<span class="file-links"><a href="/portal/partners/{{ partner.id }}/versions/{{ version.id }}/html">HTML</a><span aria-hidden="true">·</span><a href="/portal/partners/{{ partner.id }}/versions/{{ version.id }}/pdf">PDF</a></span>{% else %}—{% endif %}</td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="empty-state"><h3>Sem versões</h3><p>Uma solicitação de geração ficará na fila para a próxima etapa de processamento.</p></div>{% endif %}</div></section>
    {% if is_admin and demo and versions|length > 1 %}<section class="panel action-panel" aria-label="Restaurar versão"><div><p class="eyebrow">Recuperação</p><h2>Restaurar versão anterior</h2><p class="muted">A versão atual continua no histórico. Somente arquivos íntegros podem ser restaurados.</p></div><div class="action-group">{% for version in versions if version.storage_object_key and version.status in ['validated', 'published', 'superseded'] and (not latest_valid or version.id != latest_valid.id) %}<form method="post" action="/portal/partners/{{ partner.id }}/versions/{{ version.id }}/restore"><input type="hidden" name="csrf" value="{{ csrf }}"><label><input type="checkbox" name="confirm" value="yes" required> Confirmo restaurar v{{ version.version }}</label><button class="button button-secondary" type="submit">Restaurar v{{ version.version }}</button></form>{% endfor %}</div></section>{% endif %}
  </main><footer class="site-footer"><div class="container">Relatórios de parceiros · Acesso interno</div></footer>
</body></html>
