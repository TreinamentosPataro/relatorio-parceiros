<a class="skip-link" href="#main">Ir para o conteúdo</a>
<header class="site-header"><div class="header-inner">
  <a class="brand" href="/portal/partners"><span class="brand-mark" aria-hidden="true">P</span><span>Relatórios<span class="brand-sub">/ Parceiros</span></span></a>
  <nav class="main-nav" aria-label="Navegação principal">
    <a href="/portal/partners" {% if nav|default('') == 'partners' %}aria-current="page"{% endif %}>Início</a>
    {% if is_admin|default(false) %}<a href="/portal/imports" {% if nav|default('') == 'imports' %}aria-current="page"{% endif %}>Envios</a>{% if partner_admin_link|default(false) %}<a href="/portal/admin/partners" {% if nav|default('') == 'admin' %}aria-current="page"{% endif %}>Parceiros</a>{% endif %}{% endif %}
  </nav>
  <div class="header-actions"><span class="user-label">{{ user.display_name or 'Usuário interno' }}</span><a class="text-button" href="/portal/account/password">Alterar senha</a><form method="post" action="/portal/logout"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="text-button" type="submit">Sair</button></form></div>
</div></header>
