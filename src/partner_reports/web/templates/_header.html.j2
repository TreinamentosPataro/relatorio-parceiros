<a class="skip-link" href="#main">Ir para o conteúdo</a>
<div class="ambient" aria-hidden="true"></div>
<header class="site-header"><div class="header-inner">
  <a class="brand" href="/portal/partners"><span class="brand-mark" aria-hidden="true">P</span><span>Relatórios<span class="brand-sub"> de parceiros</span></span></a>
  <nav class="main-nav" aria-label="Navegação principal">
    <a href="/portal/partners" {% if nav|default('') == 'partners' %}aria-current="page"{% endif %}>Início</a>
    <a href="/portal/reports" {% if nav|default('') == 'reports' %}aria-current="page"{% endif %}>Relatórios prontos</a>
    {% if can_report|default(false) %}<a href="/portal/imports" {% if nav|default('') == 'imports' %}aria-current="page"{% endif %}>Envios</a>{% endif %}{% if is_admin|default(false) %}{% if partner_admin_link|default(false) %}<a href="/portal/admin/partners" {% if nav|default('') == 'admin' %}aria-current="page"{% endif %}>Parceiros</a>{% endif %}<a href="/portal/admin/users" {% if nav|default('') == 'users' %}aria-current="page"{% endif %}>Usuários</a>{% endif %}
  </nav>
  <div class="header-actions"><span class="user-chip"><span class="avatar" aria-hidden="true">{{ (user.display_name or 'U')[:1]|upper }}</span><span class="user-label">{{ user.display_name or 'Usuário interno' }}</span></span><a class="text-button quiet" href="/portal/account/password">Senha</a><form method="post" action="/portal/logout"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="text-button" type="submit">Sair</button></form></div>
</div></header>
<script src="/portal/assets.js" defer></script>
