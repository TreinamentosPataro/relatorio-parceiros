<form method="post" action="/portal/imports/new" enctype="multipart/form-data" class="upload-form">
  <input type="hidden" name="csrf" value="{{ csrf }}">
  <div class="field upload-partner"><label for="partner_id"><span class="step-dot" aria-hidden="true">1</span>Parceiro</label><select id="partner_id" name="partner_id" required><option value="">Selecione o parceiro</option>{% for partner in partners %}<option value="{{ partner.id }}" {% if selected == partner.id %}selected{% endif %}>{{ partner.name }}</option>{% endfor %}</select></div>
  <div class="field month-field"><label for="period_month"><span class="step-dot" aria-hidden="true">2</span>Mês de referência</label><select id="period_month" name="period_month" required>{% for month in months %}<option value="{{ month.value }}" {% if loop.first %}selected{% endif %}>{{ month.label }}</option>{% endfor %}</select></div>
  <div class="field upload-file">
    <label for="source_pdf"><span class="step-dot" aria-hidden="true">3</span>PDF exportado do Advbox</label>
    <label class="dropzone" for="source_pdf" data-dropzone>
      <input id="source_pdf" name="source_pdf" type="file" accept="application/pdf,.pdf" required>
      <span class="dropzone-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4"/><path d="m6 10 6-6 6 6"/><path d="M4 20h16"/></svg></span>
      <span class="dropzone-text"><strong data-dropzone-name>Arraste o PDF aqui ou clique para escolher</strong><span class="field-hint">Relatório do módulo Parceiros, sem editar. Até {{ max_mib }} MiB.</span></span>
    </label>
  </div>
  <button class="button button-primary upload-submit" type="submit">Enviar e conferir <span aria-hidden="true" class="arrow">→</span></button>
</form>
