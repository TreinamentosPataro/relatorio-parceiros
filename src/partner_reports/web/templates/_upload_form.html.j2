<form method="post" action="/portal/imports/new" enctype="multipart/form-data" class="upload-form">
  <input type="hidden" name="csrf" value="{{ csrf }}">
  <div class="field upload-partner"><label for="partner_id">1. Parceiro</label><select id="partner_id" name="partner_id" required><option value="">Selecione o parceiro</option>{% for partner in partners %}<option value="{{ partner.id }}" {% if selected == partner.id %}selected{% endif %}>{{ partner.name }}</option>{% endfor %}</select></div>
  <div class="field month-field"><label for="period_month">2. Mês de referência</label><select id="period_month" name="period_month" required>{% for month in months %}<option value="{{ month.value }}" {% if loop.first %}selected{% endif %}>{{ month.label }}</option>{% endfor %}</select></div>
  <div class="field upload-file"><label for="source_pdf">3. PDF exportado do Advbox</label><input id="source_pdf" name="source_pdf" type="file" accept="application/pdf,.pdf" required><span class="field-hint">Relatório do módulo Parceiros, sem editar. Até {{ max_mib }} MiB.</span></div>
  <button class="button button-primary upload-submit" type="submit">Enviar e conferir</button>
</form>
