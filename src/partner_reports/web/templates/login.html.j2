<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Acesso interno · Relatórios de parceiros</title>
  <link rel="stylesheet" href="/portal/assets.css">
</head>
<body class="login-page">
  <main class="login-shell">
    <div class="brand-mark" aria-hidden="true">P</div>
    <p class="eyebrow">Plataforma interna</p>
    <h1>Relatórios de parceiros</h1>
    <p class="muted">Entre com a credencial interna autorizada. O acesso aos relatórios é registrado e restrito.</p>
    {% if error %}<p class="form-error" role="alert">{{ error }}</p>{% endif %}
    <form method="post" action="/portal/login" class="login-form">
      <input type="hidden" name="csrf" value="{{ csrf }}">
      <label for="login">Identificador de acesso</label>
      <input id="login" name="login" autocomplete="username" maxlength="80" required autofocus>
      <label for="password">Senha</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required>
      <button class="button button-primary" type="submit">Entrar na plataforma <span aria-hidden="true">↗</span></button>
    </form>
    <p class="login-foot">Acesso interno · Sem consulta ao Advbox nesta tela</p>
  </main>
</body>
</html>
