<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Definir senha · Relatórios de parceiros</title>
  <link rel="stylesheet" href="/portal/assets.css">
</head>
<body class="login-page">
  <main class="login-shell">
    <div class="brand-mark" aria-hidden="true">P</div>
    {% if valid %}
    <p class="eyebrow">{{ 'Primeiro acesso' if purpose == 'invite' else 'Nova senha' }}</p>
    <h1>{{ 'Crie a sua senha' if purpose == 'invite' else 'Defina uma nova senha' }}</h1>
    <p class="muted">O seu login é <strong>{{ login_name }}</strong>. Use no mínimo {{ min_length }} caracteres; uma frase com espaços é uma boa opção. Este link funciona uma única vez.</p>
    {% if error %}<p class="form-error" role="alert">{{ error }}</p>{% endif %}
    <form method="post" action="/portal/access/{{ token }}" class="login-form">
      <input type="hidden" name="csrf" value="{{ csrf }}">
      <input type="hidden" name="username" value="{{ login_name }}" autocomplete="username">
      <label for="new_password">Senha</label>
      <input id="new_password" name="new_password" type="password" autocomplete="new-password" minlength="{{ min_length }}" maxlength="256" required autofocus>
      <label for="confirm_password">Confirme a senha</label>
      <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" minlength="{{ min_length }}" maxlength="256" required>
      <button class="button button-primary" type="submit">Salvar senha e continuar</button>
    </form>
    {% else %}
    <p class="eyebrow">Link de acesso</p>
    <h1>Link inválido ou expirado</h1>
    <p class="muted">Cada link funciona uma única vez e vale por tempo limitado. Peça um novo link a um administrador do portal.</p>
    <p class="login-foot"><a href="/portal/login">Ir para o login</a></p>
    {% endif %}
  </main>
</body>
</html>
